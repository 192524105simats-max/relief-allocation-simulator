# Copy this file to .env and set your MySQL credentials.
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=relief_db

# Cloud MySQL (e.g. Aiven): instead of the DB_* values above you can paste the
# service URI here, e.g. mysql://avnadmin:PASSWORD@host:port/defaultdb?ssl-mode=REQUIRED
# DATABASE_URL=
# Optional: CA certificate (PEM text) to verify the database server.
# DB_SSL_CA=
